<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/Directory.Build.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress missing-member XML warnings for this project; XML documentation is generated and packaged. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>IxIFlow.DemoActivities</PackageId>
    <Version>1.0.0</Version>
    <Description>Sample activity package for IxIFlow.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="..\..\src\IxIFlow.Abstractions\IxIFlow.Abstractions.csproj" />
  </ItemGroup>
</Project>
