<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient resolves a 9.0 Pkcs with known advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.assert" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IxIFlow\IxIFlow.csproj" />
    <ProjectReference Include="..\..\src\IxIFlow.Authoring\IxIFlow.Authoring.csproj" />
    <ProjectReference Include="..\IxIFlow.BundleFixtures\IxIFlow.BundleFixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="NETStandard.Library" Version="[2.0.3]" />
    <EmbeddedResource Include="NativeFixtures/win-x64/*.dll" LogicalName="IxIFlow.TestSupport.NativeFixtures.win-x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="NativeFixtures/linux-x64/*.so" LogicalName="IxIFlow.TestSupport.NativeFixtures.linux-x64.%(Filename)%(Extension)" />
    <EmbeddedResource Include="NativeFixtures/osx-arm64/*.dylib" LogicalName="IxIFlow.TestSupport.NativeFixtures.osx-arm64.%(Filename)%(Extension)" />
    <Content Include="$(NuGetPackageRoot)netstandard.library/2.0.3/build/netstandard2.0/ref/*.dll" Link="PackageDownloads/netstandard.library/2.0.3/build/netstandard2.0/ref/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
