<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageTags>workflow engine saga orchestration compensation error-handling distributed-systems distributed-transactions suspend-resume retry-policy microservices csharp dotnet dotnet-core</PackageTags>
  </PropertyGroup>

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>1.0.0.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/HumanHub/IxIFlow</RepositoryUrl>
		<Title>IxIFlow - Workflow Engine</Title>
		<Copyright>2025 - HumanHub.io</Copyright>
		<PackageProjectUrl>https://github.com/HumanHub/IxIFlow</PackageProjectUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IxIFlow.Abstractions\IxIFlow.Abstractions.csproj" />
  </ItemGroup>

  <!-- The contract and purity analyzers ship in the package and run in every project that references it (F-24, D-42). -->
  <ItemGroup>
    <ProjectReference Include="..\IxIFlow.Analyzers\IxIFlow.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\IxIFlow.Analyzers.CodeFixes\IxIFlow.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\IxIFlow.Analyzers\bin\$(Configuration)\netstandard2.0\IxIFlow.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\IxIFlow.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\IxIFlow.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
