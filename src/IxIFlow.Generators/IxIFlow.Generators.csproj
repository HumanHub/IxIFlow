<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress missing-member XML warnings for this project; XML documentation is generated and packaged. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <Description>Workflow YAML document models, validation, translation and source generation for IxIFlow.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IxIFlow.Authoring" />
    <InternalsVisibleTo Include="IxIFlow.Tests" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetGeneratorDependencies</GetTargetPathDependsOn>
  </PropertyGroup>
  <!-- Compiler hosts provide Roslyn and framework assemblies; only YamlDotNet travels with the generator. -->
  <Target Name="GetGeneratorDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(ReferenceCopyLocalPaths)" IncludeRuntimeDependency="false" ResolveableAssembly="false"
        Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'YamlDotNet'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <Compile Include="../Shared/RetryDelayRules.cs" Link="Authoring/RetryDelayRules.cs" />
  </ItemGroup>
</Project>
