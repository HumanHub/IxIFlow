<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Description>Workflow document validation and activity catalogs for IxIFlow.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="NuGet.Protocol" Version="6.14.3" />
    <PackageReference Include="NuGet.Resolver" Version="6.14.3" />
    <InternalsVisibleTo Include="IxIFlow.Tests" />
    <ProjectReference Include="..\IxIFlow\IxIFlow.csproj" />
    <ProjectReference Include="..\IxIFlow.Generators\IxIFlow.Generators.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ActivityPackages/PortableRuntimeIdentifierGraph.json" />
    <None Update="ActivityPackages/PortableRuntimeIdentifierGraph.LICENSE.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
