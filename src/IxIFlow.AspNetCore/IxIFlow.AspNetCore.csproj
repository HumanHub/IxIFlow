<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress missing-member XML warnings for this project; XML documentation is generated and packaged. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>1.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Authorized HTTP triggers, CloudEvents ingress and workflow operations for IxIFlow.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../IxIFlow/IxIFlow.csproj" />
    <ProjectReference Include="../IxIFlow.Authoring/IxIFlow.Authoring.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
