<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Suppress missing-member XML warnings for this project; XML documentation is generated and packaged. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Stateless workflow matching and host links over JSON gRPC streams.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <ProjectReference Include="../IxIFlow/IxIFlow.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IxIFlow.Tests" />
    <InternalsVisibleTo Include="IxIFlow.Conformance" />
  </ItemGroup>
</Project>
